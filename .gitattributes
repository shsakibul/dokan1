# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Declare binary files (prevent CRLF/LF corruptions)
*.jar binary
*.apk binary
*.aab binary
*.png binary
*.jpg binary
*.keystore binary
gradlew text eol=lf
